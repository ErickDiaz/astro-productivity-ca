# Copia este archivo a .env y completa los valores.
#   cp .env.example .env
# .env esta en .gitignore: nunca se versiona.

# Token de NASA ADS. Se obtiene gratis en:
#   https://ui.adsabs.harvard.edu/user/settings/token
ADS_DEV_KEY=

# Directorio raiz donde se escriben data/raw, data/interim y data/processed.
# Relativo a la raiz del repo. Opcional.
ASTROCA_DATA_DIR=data

# Directorio de cache de respuestas de la API. Evita repetir llamadas
# identicas y protege contra los rate limits. Opcional.
ASTROCA_CACHE_DIR=.cache/ads

# Segundos de espera entre llamadas a la API. Opcional.
ASTROCA_REQUEST_DELAY=0.5
